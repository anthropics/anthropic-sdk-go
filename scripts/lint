#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

# Report every compile error: the compiler otherwise stops at 10 per package.
export GOFLAGS="$GOFLAGS -gcflags=-e"

echo "==> Running Go build"
go build ./...

echo "==> Checking tests compile"
go test -run=^$ ./...

echo "==> Building examples"
cd examples && go build ./...
